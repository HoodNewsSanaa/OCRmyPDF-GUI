<component type="desktop-application">
  <id>io.github.HoodNewsSanaa.OCRmyPDF_GUI</id>
  <name>OCRmyPDF GUI</name>
  <summary>Make scanned PDFs searchable</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <developer id="io.github.hoodnewssanaa">
    <name>HoodNewsSanaa</name>
  </developer>
  <description>
    <p>
      A simple graphical front end for OCRmyPDF. Drop in scanned PDFs or images, choose
      the languages and options, and get back PDFs with a searchable, selectable text layer.
      Shows overall progress and an estimated time remaining.
    </p>
    <p>Tesseract, Ghostscript and unpaper are included; extra OCR languages can be downloaded from inside the app.</p>
  </description>
  <url type="homepage">https://github.com/HoodNewsSanaa/OCRmyPDF-GUI</url>
